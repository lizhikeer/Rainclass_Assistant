# ==============================================================================
# 雨课堂助手 (Rainclass Assistant) 飞牛 NAS Docker 部署环境变量配置示例
# 复制本文件为 .env：cp .env.example .env 并根据实际情况调整参数
# ==============================================================================

# 飞牛 NAS 数据持久化宿主机真实路径（默认挂载在项目子目录 ./data）
# 推荐飞牛生产路径，例如：/vol1/1000/docker/rainclass/data
NAS_DATA_DIR=./data

# 运行模式：
# - observe : 观察模式（首次部署验收必选！仅同步状态与课堂心跳，禁止点击、提交与付费 AI 请求）
# - auto    : 自动答题模式（验收通过后切换，全自动高速作答并提交）
WORKER_MODE=observe

# 容器内部运行用户与用户组 ID（与飞牛 NAS 登录用户 lzk 的 uid:gid 严格对齐，防止权限越界或写入被拒）
APP_UID=1000
APP_GID=1001

# 基础镜像配置（默认使用已验证兼容的 python:3.11-slim，或官方 Playwright 镜像 mcr.microsoft.com/playwright/python:v1.59.0-noble）
BASE_IMAGE=python:3.11-slim
